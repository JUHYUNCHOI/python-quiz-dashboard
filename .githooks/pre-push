#!/bin/sh
# 배포는 하루 한 번 — **문서가 아니라 걸쇠로 막는다.**
#
# 왜 (2026-09-21): 선생님이 *"난 vercel.com에는 하루에 한번만할거고"* 라고
# 이미 말씀하셨는데 9/16·17·18 에 3·5·3 번 밀었다.
# 이 얘기를 하는 메모리 문서가 **이미 셋** 있었고, 어제 CLAUDE.md 에 한 줄 더 넣었고,
# 오늘 세는 스크립트까지 만들었다. **그래도 다 '내가 기억해서 돌려야' 작동한다.**
# project-lead 판정: *"지금 상태는 문서 네 번째를 하나 더 쓴 것과 다르지 않다."*
# 그래서 걸쇠로 만든다.
#
# ⛔ `--no-verify` 로 넘기지 마라. 넘겨야 할 때는 선생님이 말씀하신다.

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main) ;;
    *) continue ;;
  esac

  # ① vercel.json 이 Vercel 스키마를 지키나 — **횟수보다 먼저 본다.**
  #    2026-09-22: ignoreCommand 가 670자(한도 256)라 **프로덕션 빌드가 통째로
  #    실패했다.** 푸시는 성공했고 git 도 걸쇠도 아무 말 안 했다.
  #    우리 걸쇠가 전부 "푸시 전 우리 쪽"만 봤기 때문이다 —
  #    **푸시 뒤 Vercel 이 vercel.json 을 검사하는 단계는 아무도 안 봤다.**
  if ! python3 scripts/check-vercel-config.py; then
    echo ""
    echo "⛔ 푸시를 막았다 — 이대로 밀면 **Vercel 빌드가 통째로 실패한다.**"
    echo "   2026-09-22 에 실제로 그랬다. 선생님이 화면을 보고 알려주셔야 알았다."
    echo "   긴 셸 로직은 스크립트 파일로 빼고 vercel.json 에선 한 줄로 불러라."
    exit 1
  fi

  if ! python3 scripts/check-deploy-budget.py; then
    echo ""
    echo "⛔ 푸시를 막았다 — 오늘 이미 밀었다."
    echo "   선생님: \"난 vercel.com에는 하루에 한번만할거고."
    echo "            특별히 해야할때는 내가 얘기하겠다고 했는데\""
    echo ""
    echo "   커밋은 계속 쌓아도 된다. 문제는 **푸시 횟수**다."
    echo "   선생님이 \"특별히\" 라고 하시면 그때만 --no-verify 로 민다."
    exit 1
  fi

  # ⏰ 오늘 첫 푸시다 — 밀어 보내면서 **확인할 것**을 여기서 말한다.
  #    (선생님 2026-09-21: *"내일 밀 때 로그로 확인해줘"*)
  #    문서에 적어 두면 또 잊는다. 미는 그 순간에 눈에 보이게 한다.
  cat <<'NOTE'

──────────────────────────────────────────────────────────
⏰ 밀고 나서 **반드시 확인할 것** — Vercel 빌드 로그
   `vercel.json` 의 건너뛰기 규칙이 진짜 도는지 아직 **한 번도 못 봤다.**

   Vercel → coderin → 이번 배포 → Building 로그에서 `[ignore]` 줄을 찾아라:

     [ignore] REF=main SHA=... PREV=[........]
       └ PREV 가 **비어 있으면** 그 환경변수가 없는 것이다 →
         지금 규칙은 "빌드" 쪽으로 넘어지므로 안전하지만, **건너뛰기는 영영 안 된다.**
         그 경우 다른 방법을 찾아야 한다 (.claude/WORK.md 에 적어 둠).
     [ignore] 화면에 닿는 변화 없음 → 건너뜀      ← 문서만 밀었을 때 이게 나와야 맞다
     [ignore] 바뀐 화면 파일: …                   ← 화면을 고쳤을 때 이게 나와야 맞다

   확인하면 `.claude/WORK.md` 의 "Vercel 건너뛰기 실측" 항목을 닫아라.
──────────────────────────────────────────────────────────

NOTE
done
exit 0
