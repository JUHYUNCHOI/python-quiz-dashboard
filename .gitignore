# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# capacitor
/ios/
/android/
scripts/output/
.superpowers/

# 확인용 빌드 산출물 (npm run build:check) — dev 서버의 .next 와 분리
#   next dev 와 next build 는 기본적으로 같은 .next 를 쓴다. dev 서버를 켜둔 채
#   빌드를 돌리면 서버가 읽던 파일이 갈아엎혀 dev 가 죽는다 (2026-08-31).
#   ⚠️ build:check 를 돌리면 Next 가 tsconfig.json 의 include 에 .next-check 경로를
#      자동으로 추가한다. 커밋하지 말 것 — `git checkout -- tsconfig.json` 으로 되돌린다.
.next-check

# 레슨의 '파일 쓰기' 연습 코드를 리포 루트에서 돌리면 생기는 찌꺼기.
# 검사 스크립트는 임시 폴더에서 돌지만, 손으로 돌릴 때 여기 떨어진다.
/a.txt
/log.txt
/memo.txt
/names.txt
/ranking.txt
/save.txt
/score.txt
/scores.txt
/test.txt
/sol.py
/sol.cpp
scripts/__pycache__/

# 에이전트가 저장소 루트에 만드는 임시 파일 — 2026-09-07 에 6개가 실수로 커밋됐다.
# Playwright 는 프로젝트 루트에서 실행해야 모듈을 찾아서, 검토자들이 여기에 스크립트를 만든다.
scratch_*
_*.mjs
*-check.mjs

# 에이전트·검증용 임시 스크립트 (루트에서 돌려야 playwright 를 찾는다)
# 2026-09-07: 검토 에이전트들이 이런 파일 15개를 루트에 남겼다.
# 2026-09-09: 주석이 두 줄로 잘려 "*-check-tmp.mjs 15개를 루트에 남겼다." 가
#             패턴처럼 들어가 있었다. 고쳤다.
scratchpad_*.mjs
scroll-check-tmp.mjs
*-check-tmp.mjs
.chk-tmp.mjs
.qa-tmp.mjs
.claude/tmp-*/
